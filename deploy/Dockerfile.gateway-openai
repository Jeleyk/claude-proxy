# Multi-stage build for the OpenAI-compatible routing gateway (cmd/openai). Same Go module as
# the Claude Code datapath gateway; only the built command differs.
FROM golang:1.26-alpine AS build
WORKDIR /app
COPY gateway/go.mod gateway/go.sum* ./
RUN go mod download 2>/dev/null || true
COPY gateway/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /gateway-openai ./cmd/openai

FROM alpine:3.20
RUN apk add --no-cache ca-certificates wget
COPY --from=build /gateway-openai /gateway-openai
EXPOSE 9100
ENTRYPOINT ["/gateway-openai"]
