# Kotlin service (management API + datapath). UI is NOT baked in — nginx serves the SPA.
# Build context = repo root; sources live under service/.
#
# ---- Stage 1: build the fat jar ----
FROM eclipse-temurin:21-jdk AS build
WORKDIR /app
COPY service/gradlew service/gradlew.bat ./
COPY service/gradle ./gradle
COPY service/settings.gradle.kts service/build.gradle.kts ./
RUN ./gradlew --version --no-daemon >/dev/null 2>&1 || true
COPY service/src ./src
RUN ./gradlew fatJar --no-daemon

# ---- Stage 2: slim runtime ----
FROM eclipse-temurin:21-jre
WORKDIR /app
# curl is used by the compose healthcheck.
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/build/libs/claude-proxy-*-all.jar app.jar
ENV BIND_HOST=0.0.0.0 \
    PORT=8787 \
    DB_PATH=/data/claude-proxy.db
EXPOSE 8787
VOLUME /data
ENTRYPOINT ["java", "-jar", "app.jar"]
