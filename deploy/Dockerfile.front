# Front image: builds the React SPA and serves the static output via nginx. Pure static —
# no reverse-proxying (the edge router in deploy/Dockerfile.nginx forwards `/` here).
# Build context = repo root (needs frontend/ and deploy/front/).
#
# ---- Stage 1: build the SPA ----
FROM node:22-slim AS spa
WORKDIR /app/frontend
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
COPY frontend/package.json ./
RUN pnpm install --no-frozen-lockfile
COPY frontend/ ./
RUN pnpm build            # → /app/frontend/dist

# ---- Stage 2: nginx serving the static build ----
FROM nginx:alpine
COPY deploy/front/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=spa /app/frontend/dist /usr/share/nginx/html
EXPOSE 8080
