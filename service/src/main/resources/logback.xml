<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{28} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="io.netty" level="WARN"/>
    <logger name="Exposed" level="WARN"/>
    <!-- Set to DEBUG to calibrate Anthropic rate-limit headers against live traffic. -->
    <logger name="RateLimitHeaders" level="INFO"/>
</configuration>
