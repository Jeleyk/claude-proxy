# ---- Required ----
# Secret used to encrypt account credentials at rest (AES-256-GCM). Use 32+ random chars.
MASTER_KEY=change-me-to-a-long-random-secret

# ---- Recommended ----
# Signs session cookies. Defaults to MASTER_KEY if unset.
SESSION_SECRET=change-me-too

# Bootstrap admin (created only when the DB has no users yet).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# ---- Networking ----
# Use 0.0.0.0 to expose on a server; 127.0.0.1 for local only.
BIND_HOST=127.0.0.1
PORT=8787
# Public origin when deployed behind a domain (enables CORS for that origin).
# PUBLIC_DOMAIN=proxy.example.com

# ---- Storage ----
DB_PATH=data/claude-proxy.db

# ---- Upstream ----
UPSTREAM_BASE_URL=https://api.anthropic.com

# ---- OAuth (optional overrides; defaults are the public Claude Code values) ----
# OAUTH_CLIENT_ID=
# OAUTH_AUTHORIZE_URL=
# OAUTH_TOKEN_URL=
# OAUTH_REDIRECT_URI=
# OAUTH_SCOPES=
